{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hbox-term",
  "version": "0.1.0",
  "identifier": "dev.elashri.hbox-term",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hbox-term",
        "width": 1200,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminal workspace for local and remote development",
    "longDescription": "hbox-term is a fast terminal workspace with agentless Linux server management over SSH.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QUQyMDIxQzc2QjA1NTIKUldSU0JXdkhJU0N0U05YbzNZaDFEZ01QY09STFJ1UWF0QzZmZ0xoUjhBVWRVRHJxbU9KcEI2aWoK",
      "endpoints": [
        "https://github.com/MohamedElashri/hbox-term/releases/latest/download/latest.json"
      ]
    }
  }
}
